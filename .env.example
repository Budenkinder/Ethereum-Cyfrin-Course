# Copy to .env and fill in. .env is gitignored; .env.example is the tracked schema.

# RPC endpoints (Alchemy / Infura / your own node)
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=

# Contract verification
ETHERSCAN_API_KEY=

# Anvil's first default account. Safe to keep here: it is a publicly known key
# that every anvil instance ships with, so it is worthless outside localhost.
ANVIL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Do NOT put a real private key here. From Foundry Fundamentals onward the
# course switches to an encrypted keystore instead:
#   cast wallet import myaccount --interactive
#   forge script ... --account myaccount --sender <your address>
